# Local paths
REMARKABLE_DATA_DIR=data
REMARKABLE_DATABASE_URL=sqlite:///remarkable.db

# OpenAI (required beginning in Milestone 5)
REMARKABLE_OPENAI_API_KEY=
REMARKABLE_OPENAI_MODEL=

# Gmail (required beginning in Milestone 8)
REMARKABLE_GMAIL_CREDENTIALS_PATH=
REMARKABLE_GMAIL_TOKEN_PATH=
REMARKABLE_GMAIL_INBOX_LABEL=remarkable-ai
REMARKABLE_GMAIL_PROCESSED_LABEL=remarkable-ai/processed
REMARKABLE_ALLOWED_SENDERS=
